# Copy this file to .env and fill in real values before running locally or with Docker.

OPENAI_API_KEY=your_openai_key
JWT_SECRET_KEY=replace_with_a_long_random_secret
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=true
GOOGLE_OAUTH_ALLOW_INSECURE_HTTP=true

# LangSmith observability (get key from smith.langchain.com)
# Required for ab_tester.py and quality_evaluator.py LangSmith logging.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_key_here
LANGCHAIN_PROJECT=researchhub-benchmarking

# Google OAuth is optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the SSO callback bounces the user back to (Streamlit dashboard).
DASHBOARD_URL=http://localhost:8501

# Optional third-party APIs kept from the current project.
ALPHA_VANTAGE_API_KEY=
TAVILY_API_KEY=

# Shared service defaults for local development outside Docker.
# Docker Compose overrides the app container hostnames automatically.
POSTGRES_DB=researhub
POSTGRES_USER=researhub
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://researhub:replace_me@localhost:5432/researhub

REDIS_URL=redis://localhost:6379/0
REDIS_EXACT_CACHE_TTL_SECONDS=3600

QDRANT_URL=http://localhost:6333

CHECKPOINTS_DB_URL=postgresql://researhub:replace_me@localhost:5432/researhub
